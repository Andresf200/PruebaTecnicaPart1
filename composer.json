{
    "name": "prueba/lecturas-api",
    "description": "API de recepción de lecturas de contador",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "yiisoft/yii2": "~2.0.55"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "repositories": [
        { "type": "composer", "url": "https://asset-packagist.org" }
    ],
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": { "yiisoft/yii2-composer": true }
    }
}